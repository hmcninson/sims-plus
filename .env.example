# ============================================================
# SIMS Plus - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# PostgreSQL (TWO-USER PATTERN)
# ----------------------------------------------------------
# The superuser account (Docker Compose / init-db.sql)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sims_plus

# sims_admin: Owns database, runs Alembic migrations (DDL)
ADMIN_DB_PASSWORD=admin_password

# sims_app_user: Runtime application user, RLS enforced
# CRITICAL: The application MUST connect as sims_app_user, never postgres.
APP_DB_PASSWORD=app_password

# Application database URL (MUST use sims_app_user)
DATABASE_URL=postgresql+asyncpg://sims_app_user:app_password@localhost:5432/sims_plus

# Alembic migration URL (uses sims_admin for DDL)
ALEMBIC_DATABASE_URL=postgresql+asyncpg://sims_admin:admin_password@localhost:5432/sims_plus

# Test database URL
DATABASE_TEST_URL=postgresql+asyncpg://sims_app_user:app_password@localhost:5432/sims_plus_test

# Connection pool
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ----------------------------------------------------------
# Redis
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------
# Security
# ----------------------------------------------------------
# CRITICAL: Generate with: openssl rand -base64 64
# Must be at least 64 characters in production, 32 in development.
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://presec.localhost:3000"]

# ----------------------------------------------------------
# Email (MailHog for local dev)
# ----------------------------------------------------------
# Start MailHog: docker-compose --profile tools up -d mailhog
# Web UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=false
SMTP_FROM_EMAIL=noreply@simsplus.io
SMTP_FROM_NAME=SIMS Plus

# ----------------------------------------------------------
# AWS S3 / MinIO (File Storage)
# ----------------------------------------------------------
# For local development, use MinIO (docker-compose --profile tools up -d minio)
# MinIO Console: http://localhost:9001 (minioadmin/minioadmin)
AWS_S3_BUCKET=sims-plus-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
USE_MINIO=true

# ----------------------------------------------------------
# SMS (Hubtel) — Leave empty for development
# ----------------------------------------------------------
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=SIMSPlus
HUBTEL_MERCHANT_ACCOUNT=

# ----------------------------------------------------------
# Mobile Money — Leave empty for development
# ----------------------------------------------------------
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox

# ----------------------------------------------------------
# Monitoring
# ----------------------------------------------------------
SENTRY_DSN=
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ----------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_SUBDOMAIN_CHECK_REQUESTS=20
RATE_LIMIT_SUBDOMAIN_CHECK_WINDOW=60
